# ---------------------------------------------------------------------------
# Copy this file to .env before you run anything:
#
#   cp .env.example .env
#
# Then fill in one key. Which key depends on which track you are running.
# You do not need both.
# ---------------------------------------------------------------------------


# The API you are calling.
#
# The value below is production and works as-is. If your dashboard shows a
# different base URL, use that one instead. Do not add a trailing slash.
PERFLO_BASE_URL=https://agent-mode-backend-prod-merge.up.railway.app


# ---------------------------------------------------------------------------
# TRACK 1: INDIVIDUAL
# You are giving your own agent a budget to spend your own money.
# ---------------------------------------------------------------------------

# An AGENT KEY. This key spends money.
#
# It is locked to one spending envelope when it is created, and it cannot be
# pointed at a different one later. It cannot create keys and it cannot change
# any spending limit. Spending is the only thing it does.
#
# Where to get it:
#   1. Sign in to your dashboard.
#   2. Go to the builder or developer section.
#   3. Create a key. Copy it immediately.
#
# The key is shown once and is never recoverable. If you lose it, revoke it and
# create another one.
#
# Prefix: perflo_live_ on production, perflo_test_ everywhere else. You do not
# choose which. The environment your base URL points at decides. The default
# base URL above is production, so expect perflo_live_ and real money.
PERFLO_AGENT_KEY=perflo_live_replace_me


# ---------------------------------------------------------------------------
# TRACK 2: BUILDER
# You are running this for your own customers, and each customer needs a
# separate budget.
# ---------------------------------------------------------------------------

# An ACCOUNT KEY. This key cannot spend a single cent.
#
# It creates spending envelopes, sets their limits, and creates the agent keys
# that spend inside them. It also reads your billing views.
#
# It cannot pay a vendor directly. It is STILL your most sensitive credential:
# it can raise any limit and mint a spending key, so treat it as a root
# credential over your balance. Secret store only.
#
# You have exactly one account key at a time. Create it in the dashboard. It is
# the only credential you need on your server, and everything in the builder
# track runs with just this one value.
#
# Where to get it:
#   1. Sign in to your dashboard.
#   2. Go to the builder or developer section.
#   3. Create an account key. Copy it immediately.
#
# Prefix: perflo_admin_live_ on production, perflo_admin_test_ elsewhere. The
# admin part is how you tell an account key from an agent key at a glance.
#
# Shown once, never recoverable, same as above.
PERFLO_ACCOUNT_KEY=perflo_admin_live_replace_me


# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Only needed for individual/02-claude-spends.ts, where Claude decides when to
# spend. Get one at https://console.anthropic.com.
# Every other example runs without it.
ANTHROPIC_API_KEY=

# Set to 1 to make every example do its free steps and then stop, before it
# spends anything. It still needs a working key, because the free steps are real
# API calls. You can also pass --dry-run to any single example.
DRY_RUN=0
